# Learn with Veeje - AI Business Intelligence Masterclass Environment Variables

# Public Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# WhatsApp Group Link for Confirmed Students
NEXT_PUBLIC_WHATSAPP_GROUP_LINK=https://chat.whatsapp.com/EXAMPLE_VEEJE_AI_BI_GROUP

# Razorpay Configuration (Test/Live Keys)
# Generate from https://dashboard.razorpay.com/app/keys
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=placeholder_secret_key_string

# Admin Dashboard Password / Secret Key
ADMIN_SECRET_KEY=admin123veeje

# Nodemailer / Gmail SMTP Configuration (Optional in Dev - logs if unconfigured)
GMAIL_USER=veeje.masterclass@gmail.com
GMAIL_APP_PASSWORD=your_app_password_here

# Google Sheets Webhook URL (Optional - fallback script provided in /scripts)
GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/YOUR_APPS_SCRIPT_ID/exec
